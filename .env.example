# ==========================================
# AgriShield - Environment Configuration Template
# ==========================================
# Copy this file to .env and configure keys for your deployment.
# NEVER commit the real .env file or credentials to source control.

# Application Core
ENVIRONMENT=development
DEBUG=True
APP_NAME=AgriShield
API_V1_STR=/api/v1
SECRET_KEY=generate-a-secure-random-secret-key-32-chars-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default uses local PostgreSQL with PostGIS, fallback to SQLite for local development
DATABASE_URL=postgresql+asyncpg://agrishield:agrishield_password@localhost:5432/agrishield_db
# For SQLite local development:
# DATABASE_URL=sqlite+aiosqlite:///./agrishield.db

# Cache / Queue (Optional for development, recommended for production)
REDIS_URL=redis://localhost:6379/0

# Agricultural Market & Government APIs (OGD Platform - data.gov.in)
# Register at https://data.gov.in/ to get API Key for AGMARKNET Mandi data
DATA_GOV_IN_API_KEY=your_datagov_api_key_here

# Weather & Agro-meteorology Services
# Open-Meteo is free (non-commercial < 10k calls/day) and requires NO key for default tier
# If using Commercial API Key:
OPEN_METEO_API_KEY=

# Bhashini / Indic Language Voice & Translation (Optional - Digital India Bhashini)
# Register at https://bhashini.gov.in/ to obtain credentials
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# SMS & Emergency Alert Gateway (For Farmer SMS Advisories - e.g. CDAC SMS Seva / Twilio / Gupshup)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=AGRSHD

# Cloud Storage for Disaster Evidence & Damage Photos (MinIO / S3 / Local storage)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./uploads
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET_NAME=agrishield-evidence

# Agricultural Extension & Pilot Region
PILOT_STATE=Tamil Nadu
PILOT_DEFAULT_DISTRICT=Dindigul
DEFAULT_LOCALE=ta
